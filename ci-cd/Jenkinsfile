// Jenkinsfile — Container & Kubernetes Security Scanner project
//
// Pipeline flow (matches the architecture diagram in the project report):
//   Checkout -> Build Docker Image -> Trivy Image Scan -> Trivy Config Scan
//     -> Security Gate -> Deploy to Minikube (only if gate passes)
//   A Slack notification fires on any pipeline failure.
//
// Prerequisites on the Jenkins agent: docker, trivy, kubectl (configured
// against your Minikube context), and a Slack Incoming Webhook credential
// named 'slack-webhook-url'.

pipeline {
    agent any

    environment {
        IMAGE_NAME       = "demo-target-service"
        IMAGE_TAG        = "${env.BUILD_NUMBER}"
        FULL_IMAGE       = "${IMAGE_NAME}:${IMAGE_TAG}"
        TRIVY_SEVERITY   = "CRITICAL,HIGH"
        TRIVY_REPORT_DIR = "trivy-reports"
        BACKEND_URL      = "http://localhost:8000"   // FastAPI ingestion endpoint
        K8S_NAMESPACE    = "secure-devops-demo"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('app') {
                    sh "docker build -t ${FULL_IMAGE} -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """
                    chmod +x ci-cd/trivy/trivy-image-scan.sh
                    ./ci-cd/trivy/trivy-image-scan.sh ${FULL_IMAGE}
                """
            }
        }

        stage('Trivy Kubernetes / IaC Config Scan') {
            steps {
                sh """
                    chmod +x ci-cd/trivy/trivy-config-scan.sh
                    ./ci-cd/trivy/trivy-config-scan.sh k8s/
                """
            }
        }

        stage('Publish Scan Results to Backend') {
            steps {
                sh """
                    curl -s -X POST "${BACKEND_URL}/ingest/trivy-report?scan_type=image&target=${FULL_IMAGE}" \
                      -H 'Content-Type: application/json' \
                      --data @${TRIVY_REPORT_DIR}/image-scan-report.json \
                      || echo 'Backend not reachable — skipping ingestion (non-fatal in local demo)'

                    curl -s -X POST "${BACKEND_URL}/ingest/trivy-report?scan_type=config&target=k8s-manifests" \
                      -H 'Content-Type: application/json' \
                      --data @${TRIVY_REPORT_DIR}/config-scan-report.json \
                      || echo 'Backend not reachable — skipping ingestion (non-fatal in local demo)'
                """
            }
        }

        stage('Security Gate') {
            steps {
                echo "Security gate passed: image and config scans found no ${TRIVY_SEVERITY} findings. Proceeding to deployment."
            }
        }

        stage('Deploy to Minikube') {
            steps {
                sh """
                    kubectl apply -f k8s/namespace.yaml
                    kubectl set image deployment/demo-target-service \
                        demo-target-service=${FULL_IMAGE} \
                        -n ${K8S_NAMESPACE} --record || \
                    kubectl apply -f k8s/deployment.yaml -n ${K8S_NAMESPACE}
                    kubectl apply -f k8s/service.yaml -n ${K8S_NAMESPACE}
                """
            }
        }
    }

    post {
        failure {
            withCredentials([string(credentialsId: 'slack-webhook-url', variable: 'SLACK_URL')]) {
                sh """
                    curl -s -X POST -H 'Content-Type: application/json' \
                    --data '{"text": "❌ Pipeline #${env.BUILD_NUMBER} FAILED — security gate blocked deployment. See: ${env.BUILD_URL}"}' \
                    ${SLACK_URL}
                """
            }
        }
        success {
            echo "Pipeline #${env.BUILD_NUMBER} completed successfully — deployment allowed."
        }
    }
}
