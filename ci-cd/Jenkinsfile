pipeline {
    agent any

    environment {
        IMAGE_NAME = "demo-target-service"
        IMAGE_TAG = "${BUILD_NUMBER}"

        BACKEND_URL = "http://host.docker.internal:8000"
        KUBECONFIG = "/var/jenkins_home/.kube/config"

        K8S_NAMESPACE = "secure-devops-demo"
        K8S_DEPLOYMENT = "demo-target-service"
        K8S_SERVICE = "demo-target-service"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Checking out source code..."

                checkout scm

                sh '''
                    echo "================ PROJECT FILES ================"
                    ls -la

                    echo "================ APP FILES ================"
                    ls -la app
                '''
            }
        }


        stage('Build Docker Image') {
            steps {
                echo "Building Alpine-based Docker image..."

                sh '''
                    docker build \
                        -f app/Dockerfile \
                        -t ${IMAGE_NAME}:${IMAGE_TAG} \
                        app
                '''
            }
        }


        stage('Verify Docker Image') {
            steps {
                echo "Verifying Docker image..."

                sh '''
                    echo "================ IMAGE INSPECT ================"

                    docker image inspect ${IMAGE_NAME}:${IMAGE_TAG}

                    echo "================ RUNNING USER ================"

                    docker run --rm \
                        ${IMAGE_NAME}:${IMAGE_TAG} \
                        id

                    echo "================ PYTHON PACKAGES ================"

                    docker run --rm \
                        ${IMAGE_NAME}:${IMAGE_TAG} \
                        python -c "
import fastapi
import starlette
import uvicorn
import setuptools
import msgpack

print('FastAPI:', fastapi.__version__)
print('Starlette:', starlette.__version__)
print('Uvicorn:', uvicorn.__version__)
print('Setuptools:', setuptools.__version__)
print('Msgpack:', msgpack.__version__)
"
                '''
            }
        }


        stage('Trivy Image Scan') {
            steps {
                echo "Scanning Docker image with Trivy..."

                sh '''
                    echo "================ TRIVY IMAGE SCAN ================"

                    trivy image \
                        --scanners vuln \
                        --severity CRITICAL,HIGH \
                        --exit-code 0 \
                        --format table \
                        ${IMAGE_NAME}:${IMAGE_TAG} \
                        | tee trivy-image-scan.txt

                    echo "================ TRIVY JSON REPORT ================"

                    trivy image \
                        --scanners vuln \
                        --severity CRITICAL,HIGH \
                        --exit-code 0 \
                        --format json \
                        -o trivy-image-report.json \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }


        stage('Generate Trivy SBOM') {
            steps {
                echo "Generating CycloneDX SBOM..."

                sh '''
                    echo "================ GENERATING SBOM ================"

                    trivy image \
                        --format cyclonedx \
                        --output trivy-image-sbom.json \
                        ${IMAGE_NAME}:${IMAGE_TAG}

                    echo "SBOM generated successfully."

                    ls -lh trivy-image-sbom.json
                '''
            }
        }


        stage('Verify Trivy SBOM Packages') {
            steps {
                echo "Checking package versions detected by Trivy..."

                sh '''
                    echo "================ SEARCHING SBOM ================"

                    python3 - <<'PY'
import json

with open("trivy-image-sbom.json", "r") as f:
    data = json.load(f)

components = data.get("components", [])

for component in components:
    name = component.get("name", "")
    version = component.get("version", "")

    if name.lower() in ["msgpack", "setuptools"]:
        print(f"SBOM PACKAGE: {name} -> {version}")
PY
                '''
            }
        }


        stage('Prepare Kubernetes Scan') {
            steps {
                echo "Preparing Kubernetes manifests..."

                sh '''
                    rm -rf trivy-scan-k8s

                    mkdir -p trivy-scan-k8s

                    cp k8s/deployment.yaml trivy-scan-k8s/
                    cp k8s/namespace.yaml trivy-scan-k8s/
                    cp k8s/service.yaml trivy-scan-k8s/

                    echo "================ K8S FILES ================"

                    ls -la trivy-scan-k8s
                '''
            }
        }


        stage('Trivy Kubernetes Scan') {
            steps {
                echo "Scanning Kubernetes configuration..."

                sh '''
                    echo "================ KUBERNETES SCAN ================"

                    trivy config \
                        --severity CRITICAL,HIGH \
                        --exit-code 0 \
                        --format table \
                        trivy-scan-k8s \
                        | tee trivy-k8s-scan.txt

                    echo "================ KUBERNETES JSON ================"

                    trivy config \
                        --severity CRITICAL,HIGH \
                        --exit-code 0 \
                        --format json \
                        -o trivy-k8s-report.json \
                        trivy-scan-k8s
                '''
            }
        }


        stage('Publish Scan Results') {
            steps {
                echo "Publishing scan results to FastAPI..."

                sh '''
                    echo "================ BACKEND HEALTH ================"

                    curl -s --fail \
                        ${BACKEND_URL}/health

                    echo ""

                    echo "================ PUBLISH IMAGE REPORT ================"

                    curl -s --fail \
                        -X POST \
                        -H "Content-Type: application/json" \
                        --data-binary @trivy-image-report.json \
                        ${BACKEND_URL}/ingest/trivy-report \
                        || echo "Image report publishing failed"

                    echo ""

                    echo "================ PUBLISH K8S REPORT ================"

                    curl -s --fail \
                        -X POST \
                        -H "Content-Type: application/json" \
                        --data-binary @trivy-k8s-report.json \
                        ${BACKEND_URL}/ingest/trivy-report \
                        || echo "Kubernetes report publishing failed"

                    echo ""
                '''
            }
        }


        stage('Security Gate') {
            steps {
                script {

                    echo "============================================"
                    echo "          SECURITY GATE"
                    echo "============================================"

                    echo "Checking Docker image vulnerabilities..."

                    def imageGate = sh(
                        script: """
                            trivy image \
                                --scanners vuln \
                                --severity CRITICAL,HIGH \
                                --exit-code 1 \
                                ${IMAGE_NAME}:${IMAGE_TAG}
                        """,
                        returnStatus: true
                    )


                    echo "Checking Kubernetes configuration..."

                    def kubernetesGate = sh(
                        script: """
                            trivy config \
                                --severity CRITICAL,HIGH \
                                --exit-code 1 \
                                trivy-scan-k8s
                        """,
                        returnStatus: true
                    )


                    echo "============================================"
                    echo "Docker Image Gate      : ${imageGate}"
                    echo "Kubernetes Config Gate : ${kubernetesGate}"
                    echo "============================================"


                    if (imageGate != 0) {
                        echo "❌ Docker Image Security Gate FAILED"
                    } else {
                        echo "✅ Docker Image Security Gate PASSED"
                    }


                    if (kubernetesGate != 0) {
                        echo "❌ Kubernetes Security Gate FAILED"
                    } else {
                        echo "✅ Kubernetes Security Gate PASSED"
                    }


                    if (imageGate != 0 || kubernetesGate != 0) {

                        error(
                            "Security Gate FAILED. Deployment stopped."
                        )
                    }


                    echo "============================================"
                    echo "✅ ALL SECURITY GATES PASSED"
                    echo "============================================"
                }
            }
        }


        stage('Deploy to Kubernetes') {
            steps {
                echo "Deploying to Minikube..."

                sh '''
                    export KUBECONFIG=${KUBECONFIG}

                    echo "================ KUBERNETES NODES ================"

                    kubectl get nodes

                    echo "================ APPLY NAMESPACE ================"

                    kubectl apply \
                        -f k8s/namespace.yaml

                    echo "================ APPLY DEPLOYMENT ================"

                    kubectl apply \
                        -f k8s/deployment.yaml

                    echo "================ APPLY SERVICE ================"

                    kubectl apply \
                        -f k8s/service.yaml

                    echo "================ UPDATE IMAGE ================"

                    kubectl set image \
                        deployment/${K8S_DEPLOYMENT} \
                        ${K8S_DEPLOYMENT}=${IMAGE_NAME}:${IMAGE_TAG} \
                        -n ${K8S_NAMESPACE}

                    echo "================ WAIT FOR ROLLOUT ================"

                    kubectl rollout status \
                        deployment/${K8S_DEPLOYMENT} \
                        -n ${K8S_NAMESPACE} \
                        --timeout=180s

                    echo "================ DEPLOYMENT ================"

                    kubectl get deployment \
                        -n ${K8S_NAMESPACE}

                    echo "================ PODS ================"

                    kubectl get pods \
                        -n ${K8S_NAMESPACE} \
                        -o wide

                    echo "================ SERVICES ================"

                    kubectl get svc \
                        -n ${K8S_NAMESPACE}
                '''
            }
        }
    }


    post {

        success {
            echo """
            ============================================
                    PIPELINE SUCCESS
            ============================================
            Build: ${BUILD_NUMBER}

            Image:
            ${IMAGE_NAME}:${IMAGE_TAG}

            Docker Image Security : PASSED
            Kubernetes Security   : PASSED
            Kubernetes Deployment : SUCCESS

            ============================================
            """
        }


        failure {
            echo """
            ============================================
                    PIPELINE FAILED
            ============================================
            Build: ${BUILD_NUMBER}

            The pipeline was stopped because
            a security gate failed.

            Check:
            1. Trivy image report
            2. Trivy SBOM
            3. Jenkins Console Output

            ============================================
            """
        }


        always {
            echo "Archiving Trivy reports..."

            archiveArtifacts(
                artifacts: '''
                    trivy-image-scan.txt,
                    trivy-image-report.json,
                    trivy-image-sbom.json,
                    trivy-k8s-scan.txt,
                    trivy-k8s-report.json
                ''',
                allowEmptyArchive: true
            )

            sh '''
                rm -rf trivy-scan-k8s
            '''
        }
    }
}