pipeline {
    agent any

    environment {
        IMAGE_NAME = "demo-target-service"
        IMAGE_TAG = "${BUILD_NUMBER}"

        BACKEND_URL = "http://host.docker.internal:8000"
        KUBECONFIG = "/var/jenkins_home/.kube/config"

        K8S_NAMESPACE = "secure-devops-demo"
        K8S_DEPLOYMENT = "demo-target-service"
        K8S_SERVICE = "demo-target-service"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Checking out source code..."

                checkout scm

                sh '''
                    echo "Project files:"
                    ls -la

                    echo "App files:"
                    ls -la app
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Alpine-based Docker image..."

                sh '''
                    docker build \
                        -f app/Dockerfile \
                        -t ${IMAGE_NAME}:${IMAGE_TAG} \
                        app
                '''
            }
        }

        stage('Verify Docker Image') {
            steps {
                echo "Verifying Docker image..."

                sh '''
                    docker image inspect ${IMAGE_NAME}:${IMAGE_TAG}

                    echo "Running user:"
                    docker run --rm ${IMAGE_NAME}:${IMAGE_TAG} id

                    echo "Checking Python packages:"
                    docker run --rm ${IMAGE_NAME}:${IMAGE_TAG} \
                        python -c "import fastapi,starlette,uvicorn,setuptools,msgpack; print('FastAPI:',fastapi.__version__); print('Starlette:',starlette.__version__); print('Uvicorn:',uvicorn.__version__); print('Setuptools:',setuptools.__version__); print('Msgpack:',msgpack.__version__)"
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                echo "Scanning Docker image with Trivy..."

                sh '''
                    trivy image \
                        --scanners vuln \
                        --severity CRITICAL,HIGH \
                        --exit-code 0 \
                        --format table \
                        ${IMAGE_NAME}:${IMAGE_TAG} \
                        | tee trivy-image-scan.txt

                    trivy image \
                        --scanners vuln \
                        --severity CRITICAL,HIGH \
                        --exit-code 0 \
                        --format json \
                        -o trivy-image-report.json \
                        ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Prepare Kubernetes Scan') {
            steps {
                echo "Preparing Kubernetes manifests..."

                sh '''
                    rm -rf trivy-scan-k8s
                    mkdir -p trivy-scan-k8s

                    cp k8s/deployment.yaml trivy-scan-k8s/
                    cp k8s/namespace.yaml trivy-scan-k8s/
                    cp k8s/service.yaml trivy-scan-k8s/

                    ls -la trivy-scan-k8s
                '''
            }
        }

        stage('Trivy Kubernetes Scan') {
            steps {
                echo "Scanning Kubernetes configuration..."

                sh '''
                    trivy config \
                        --severity CRITICAL,HIGH \
                        --exit-code 0 \
                        --format table \
                        trivy-scan-k8s \
                        | tee trivy-k8s-scan.txt

                    trivy config \
                        --severity CRITICAL,HIGH \
                        --exit-code 0 \
                        --format json \
                        -o trivy-k8s-report.json \
                        trivy-scan-k8s
                '''
            }
        }

        stage('Publish Scan Results') {
            steps {
                echo "Publishing scan results to FastAPI..."

                sh '''
                    echo "Checking FastAPI backend..."

                    curl -s --fail \
                        ${BACKEND_URL}/health

                    echo ""

                    echo "Publishing image report..."

                    curl -s --fail \
                        -X POST \
                        -H "Content-Type: application/json" \
                        --data-binary @trivy-image-report.json \
                        ${BACKEND_URL}/ingest/trivy-report \
                        || echo "Image report publishing failed"

                    echo ""

                    echo "Publishing Kubernetes report..."

                    curl -s --fail \
                        -X POST \
                        -H "Content-Type: application/json" \
                        --data-binary @trivy-k8s-report.json \
                        ${BACKEND_URL}/ingest/trivy-report \
                        || echo "Kubernetes report publishing failed"
                '''
            }
        }

        stage('Security Gate') {
            steps {
                script {

                    echo "Running Docker image security gate..."

                    def imageGate = sh(
                        script: """
                            trivy image \
                                --scanners vuln \
                                --severity CRITICAL,HIGH \
                                --exit-code 1 \
                                ${IMAGE_NAME}:${IMAGE_TAG}
                        """,
                        returnStatus: true
                    )

                    echo "Running Kubernetes security gate..."

                    def kubernetesGate = sh(
                        script: """
                            trivy config \
                                --severity CRITICAL,HIGH \
                                --exit-code 1 \
                                trivy-scan-k8s
                        """,
                        returnStatus: true
                    )

                    echo "Docker Image Gate: ${imageGate}"
                    echo "Kubernetes Config Gate: ${kubernetesGate}"

                    if (imageGate != 0) {
                        echo "❌ Docker Image Security Gate FAILED"
                    } else {
                        echo "✅ Docker Image Security Gate PASSED"
                    }

                    if (kubernetesGate != 0) {
                        echo "❌ Kubernetes Security Gate FAILED"
                    } else {
                        echo "✅ Kubernetes Security Gate PASSED"
                    }

                    if (imageGate != 0 || kubernetesGate != 0) {
                        error("Security Gate FAILED. Deployment stopped.")
                    }

                    echo "✅ ALL SECURITY GATES PASSED"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo "Deploying to Minikube..."

                sh '''
                    export KUBECONFIG=${KUBECONFIG}

                    echo "Kubernetes nodes:"
                    kubectl get nodes

                    echo "Applying namespace:"
                    kubectl apply -f k8s/namespace.yaml

                    echo "Applying deployment:"
                    kubectl apply -f k8s/deployment.yaml

                    echo "Applying service:"
                    kubectl apply -f k8s/service.yaml

                    echo "Updating image:"
                    kubectl set image \
                        deployment/${K8S_DEPLOYMENT} \
                        ${K8S_DEPLOYMENT}=${IMAGE_NAME}:${IMAGE_TAG} \
                        -n ${K8S_NAMESPACE}

                    echo "Waiting for rollout:"
                    kubectl rollout status \
                        deployment/${K8S_DEPLOYMENT} \
                        -n ${K8S_NAMESPACE} \
                        --timeout=180s

                    echo "Deployment:"
                    kubectl get deployment \
                        -n ${K8S_NAMESPACE}

                    echo "Pods:"
                    kubectl get pods \
                        -n ${K8S_NAMESPACE} \
                        -o wide

                    echo "Services:"
                    kubectl get svc \
                        -n ${K8S_NAMESPACE}
                '''
            }
        }
    }

    post {

        success {
            echo """
            ============================================
                    PIPELINE SUCCESS
            ============================================

            Build: ${BUILD_NUMBER}
            Image: ${IMAGE_NAME}:${IMAGE_TAG}

            Docker Image Security : PASSED
            Kubernetes Security   : PASSED
            Kubernetes Deployment  : SUCCESS

            ============================================
            """
        }

        failure {
            echo """
            ============================================
                    PIPELINE FAILED
            ============================================

            Build: ${BUILD_NUMBER}

            Check the Jenkins Console Output
            and Trivy reports.

            ============================================
            """
        }

        always {
            echo "Archiving Trivy reports..."

            archiveArtifacts(
                artifacts: 'trivy-image-scan.txt,trivy-image-report.json,trivy-k8s-scan.txt,trivy-k8s-report.json',
                allowEmptyArchive: true
            )

            sh '''
                rm -rf trivy-scan-k8s
            '''
        }
    }
}