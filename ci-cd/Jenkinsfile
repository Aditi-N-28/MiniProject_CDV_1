pipeline {

    agent any

    environment {
        APP_NAME = "demo-target-service"
        IMAGE_TAG = "${BUILD_NUMBER}"
        IMAGE_NAME = "${APP_NAME}:${IMAGE_TAG}"

        TRIVY_SEVERITY = "CRITICAL,HIGH"
        TRIVY_REPORT_DIR = "trivy-reports"

        BACKEND_URL = "http://host.docker.internal:8000"
        KUBECONFIG = "/var/jenkins_home/.kube/config"

        K8S_NAMESPACE = "secure-devops-demo"
    }

    stages {

        /*
         * ==========================================
         * 1. CHECKOUT
         * ==========================================
         */
        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "========================================"
                    echo "Repository checkout completed"
                    echo "========================================"

                    git status
                    git log -1 --oneline
                '''
            }
        }


        /*
         * ==========================================
         * 2. BUILD DOCKER IMAGE
         * ==========================================
         */
        stage('Docker Build') {
            steps {
                sh '''
                    echo "========================================"
                    echo "Building Docker image"
                    echo "========================================"

                    docker build \
                        -t ${IMAGE_NAME} \
                        ./app

                    echo "Docker image built successfully:"
                    docker images ${APP_NAME}
                '''
            }
        }


        /*
         * ==========================================
         * 3. VERIFY IMAGE
         * ==========================================
         */
        stage('Verify Docker Image') {
            steps {
                sh '''
                    echo "========================================"
                    echo "Verifying Docker image"
                    echo "========================================"

                    docker image inspect ${IMAGE_NAME}

                    echo "Image verification successful."
                '''
            }
        }


        /*
         * ==========================================
         * 4. TRIVY IMAGE SCAN
         * ==========================================
         */
        stage('Trivy Image Security Scan') {
            steps {
                sh '''
                    echo "========================================"
                    echo "Trivy Docker Image Security Scan"
                    echo "========================================"

                    mkdir -p ${TRIVY_REPORT_DIR}

                    trivy image \
                        --severity ${TRIVY_SEVERITY} \
                        --format json \
                        --output ${TRIVY_REPORT_DIR}/image-scan-report.json \
                        --exit-code 0 \
                        ${IMAGE_NAME}

                    echo ""
                    echo "Generating human-readable image report..."

                    trivy image \
                        --severity ${TRIVY_SEVERITY} \
                        --format table \
                        --exit-code 0 \
                        ${IMAGE_NAME} \
                        > ${TRIVY_REPORT_DIR}/image-scan-report.txt

                    echo ""
                    echo "Trivy image scan completed."
                '''
            }
        }


        /*
         * ==========================================
         * 5. TRIVY KUBERNETES / IaC SCAN
         * ==========================================
         */
        stage('Trivy Kubernetes / IaC Config Scan') {
            steps {
                sh '''
                    echo "========================================"
                    echo "Trivy Kubernetes / IaC Security Scan"
                    echo "========================================"

                    mkdir -p ${TRIVY_REPORT_DIR}

                    echo "Preparing Kubernetes manifests..."

                    rm -rf trivy-scan-k8s
                    mkdir -p trivy-scan-k8s

                    cp k8s/deployment.yaml trivy-scan-k8s/
                    cp k8s/namespace.yaml trivy-scan-k8s/
                    cp k8s/service.yaml trivy-scan-k8s/

                    echo ""
                    echo "Files prepared for Trivy:"

                    ls -la trivy-scan-k8s

                    echo ""
                    echo "Running Trivy configuration scan..."

                    trivy config \
                        --severity ${TRIVY_SEVERITY} \
                        --format json \
                        --output ${TRIVY_REPORT_DIR}/config-scan-report.json \
                        --exit-code 0 \
                        trivy-scan-k8s

                    echo ""
                    echo "Generating human-readable configuration report..."

                    trivy config \
                        --severity ${TRIVY_SEVERITY} \
                        --format table \
                        --exit-code 0 \
                        trivy-scan-k8s \
                        > ${TRIVY_REPORT_DIR}/config-scan-report.txt

                    echo ""
                    echo "Trivy Kubernetes configuration scan completed."
                '''
            }
        }


        /*
         * ==========================================
         * 6. SECURITY GATE
         * ==========================================
         */
        stage('Security Gate') {
            steps {
                script {

                    echo "========================================"
                    echo "SECURITY GATE"
                    echo "========================================"

                    /*
                     * IMAGE SECURITY GATE
                     *
                     * exit-code 1 means:
                     * Pipeline will receive non-zero status
                     * if HIGH or CRITICAL vulnerabilities exist.
                     */
                    def imageGate = sh(
                        script: """
                            trivy image \
                                --severity ${TRIVY_SEVERITY} \
                                --exit-code 1 \
                                --format table \
                                ${IMAGE_NAME}
                        """,
                        returnStatus: true
                    )


                    /*
                     * KUBERNETES CONFIGURATION SECURITY GATE
                     */
                    def configGate = sh(
                        script: """
                            trivy config \
                                --severity ${TRIVY_SEVERITY} \
                                --exit-code 1 \
                                --format table \
                                trivy-scan-k8s
                        """,
                        returnStatus: true
                    )


                    echo ""
                    echo "========================================"
                    echo "Security Gate Results"
                    echo "========================================"

                    echo "Docker Image Gate Result: ${imageGate}"
                    echo "Kubernetes Config Gate Result: ${configGate}"


                    /*
                     * If either scan fails,
                     * stop the pipeline.
                     */
                    if (imageGate != 0 || configGate != 0) {

                        echo ""
                        echo "========================================"
                        echo "SECURITY GATE FAILED"
                        echo "========================================"

                        echo "HIGH or CRITICAL security issues detected."
                        echo "Deployment will NOT continue."

                        error("Security Gate Failed")

                    } else {

                        echo ""
                        echo "========================================"
                        echo "SECURITY GATE PASSED"
                        echo "========================================"

                        echo "No HIGH or CRITICAL issues detected."
                        echo "Pipeline can continue to deployment."
                    }
                }
            }
        }


        /*
         * ==========================================
         * 7. PUBLISH SCAN RESULTS
         * ==========================================
         */
        stage('Publish Scan Results') {
            steps {
                sh '''
                    echo "========================================"
                    echo "Publishing scan results to FastAPI"
                    echo "========================================"

                    if [ -f "${TRIVY_REPORT_DIR}/image-scan-report.json" ]; then

                        echo "Uploading Trivy image report..."

                        curl -s -X POST \
                            "${BACKEND_URL}/ingest/trivy-report" \
                            -H "Content-Type: application/json" \
                            --data-binary @"${TRIVY_REPORT_DIR}/image-scan-report.json" \
                            || echo "Image report upload failed"

                    fi


                    if [ -f "${TRIVY_REPORT_DIR}/config-scan-report.json" ]; then

                        echo "Uploading Trivy configuration report..."

                        curl -s -X POST \
                            "${BACKEND_URL}/ingest/trivy-report" \
                            -H "Content-Type: application/json" \
                            --data-binary @"${TRIVY_REPORT_DIR}/config-scan-report.json" \
                            || echo "Config report upload failed"

                    fi

                    echo ""
                    echo "Scan result publishing completed."
                '''
            }
        }


        /*
         * ==========================================
         * 8. DEPLOY TO KUBERNETES
         * ==========================================
         */
        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    echo "========================================"
                    echo "Deploying to Kubernetes"
                    echo "========================================"

                    echo "Kubernetes cluster:"
                    kubectl cluster-info

                    echo ""
                    echo "Creating namespace if required..."

                    kubectl apply -f k8s/namespace.yaml

                    echo ""
                    echo "Applying deployment..."

                    kubectl apply -f k8s/deployment.yaml

                    echo ""
                    echo "Applying service..."

                    kubectl apply -f k8s/service.yaml

                    echo ""
                    echo "Updating deployment image..."

                    kubectl set image \
                        deployment/${APP_NAME} \
                        ${APP_NAME}=${IMAGE_NAME} \
                        -n ${K8S_NAMESPACE}

                    echo ""
                    echo "Waiting for deployment rollout..."

                    kubectl rollout status \
                        deployment/${APP_NAME} \
                        -n ${K8S_NAMESPACE} \
                        --timeout=180s

                    echo ""
                    echo "========================================"
                    echo "KUBERNETES DEPLOYMENT SUCCESSFUL"
                    echo "========================================"

                    echo ""
                    echo "Pods:"
                    kubectl get pods -n ${K8S_NAMESPACE}

                    echo ""
                    echo "Services:"
                    kubectl get services -n ${K8S_NAMESPACE}
                '''
            }
        }


        /*
         * ==========================================
         * 9. VERIFY DEPLOYMENT
         * ==========================================
         */
        stage('Verify Deployment') {
            steps {
                sh '''
                    echo "========================================"
                    echo "Verifying Kubernetes Deployment"
                    echo "========================================"

                    kubectl get deployment \
                        ${APP_NAME} \
                        -n ${K8S_NAMESPACE}

                    echo ""
                    echo "Pod status:"

                    kubectl get pods \
                        -n ${K8S_NAMESPACE} \
                        -o wide

                    echo ""
                    echo "Deployment verification completed."
                '''
            }
        }
    }


    /*
     * ==========================================
     * POST ACTIONS
     * ==========================================
     */
    post {

        success {
            echo """
            ========================================
            PIPELINE SUCCESSFUL
            ========================================

            Application : ${APP_NAME}
            Image       : ${IMAGE_NAME}
            Namespace   : ${K8S_NAMESPACE}

            Security scans passed.
            Kubernetes deployment completed.
            ========================================
            """
        }


        failure {
            echo """
            ========================================
            PIPELINE FAILED
            ========================================

            Application : ${APP_NAME}
            Build       : ${BUILD_NUMBER}

            Check the Jenkins console output
            for security or deployment errors.

            Deployment was blocked if the
            Security Gate failed.
            ========================================
            """
        }


        always {
            echo "Archiving Trivy reports..."

            archiveArtifacts(
                artifacts: 'trivy-reports/*.json,trivy-reports/*.txt',
                allowEmptyArchive: true
            )

            echo "Cleaning temporary Trivy Kubernetes directory..."

            sh '''
                rm -rf trivy-scan-k8s
            '''
        }
    }
}