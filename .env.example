# Copy this file to .env and fill in real values. Never commit the real .env.

# Slack Incoming Webhook URL — create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXX/XXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXX

# Where the FastAPI backend is reachable from the dashboard / ml scripts / Jenkins
BACKEND_URL=http://localhost:8000

# SQLite database path override (defaults to backend/security_scanner.db)
SCANNER_DB_PATH=./backend/security_scanner.db
